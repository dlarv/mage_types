; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mage-Types"
config/version="0.4.2"
run/main_scene="res://world/world.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
run/flush_stdout_on_print.debug=false
config/icon="res://assets/sprites/icon.svg"

[autoload]

ElementManager="*res://src/elements/element_manager.tscn"
Logger="*res://src/logger.tscn"
Settings="*res://src/settings/settings.tscn"
Inventory="*res://src/items/Inventory.tscn"
UIManager="*res://src/gui/ui_manager.tscn"
StoryManager="*res://src/story_system/story_manager.tscn"

[debug]

gdscript/warnings/unused_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0

[display]

window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="Mage-Types"

[editor]

movie_writer/movie_file="/home/hyrum/coding/gamedev/mage_types/assets/graphics/info_graphics/output/output.avi"
movie_writer/disable_vsync=true

[editor_plugins]

enabled=PackedStringArray("res://addons/attackbuilder/plugin.cfg", "res://addons/dialogue_nodes/plugin.cfg", "res://addons/gut/plugin.cfg", "res://addons/matchupmanager/plugin.cfg", "res://addons/room_and_portals/plugin.cfg")

[global_group]

persist=""
wild_enemies=""
player=""

[gui]

theme/custom="res://assets/theme.tres"

