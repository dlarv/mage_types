; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mage-Types"
config/version="0.6.9"
run/main_scene="uid://bpknr2o40rp3b"
config/features=PackedStringArray("4.4", "GL Compatibility")
run/flush_stdout_on_print.debug=false
config/icon="uid://c510ou4fg55vi"

[autoload]

ElementManager="*res://src/elements/element_manager.tscn"
Logger="*res://src/logger.tscn"
Settings="*res://src/settings/settings.tscn"
StoryManager="*res://src/story_system/story_manager.tscn"
Inventory="*res://src/items/Inventory.tscn"
UIManager="*res://src/gui/ui_manager.tscn"
Battle="*res://src/battle_system/battle.tscn"
TooltipManager="*res://addons/tooltips_pro/scripts/tooltip_manager.gd"
TooltipPlaceholderVariables="*res://addons/tooltips_pro/scripts/tooltip_placeholder_variables.gd"

[debug]

gdscript/warnings/unused_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/untyped_declaration=1

[display]

window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="Mage-Types"

[editor]

movie_writer/movie_file="/home/hyrum/coding/gamedev/mage_types/assets/graphics/info_graphics/output/output.avi"
movie_writer/disable_vsync=true
run/main_run_args="--verbose"

[editor_plugins]

enabled=PackedStringArray("res://addons/attackeffectinspector/plugin.cfg", "res://addons/database_manager/plugin.cfg", "res://addons/dialogue_nodes/plugin.cfg", "res://addons/gut/plugin.cfg", "res://addons/matchupmanager/plugin.cfg", "res://addons/room_and_portals/plugin.cfg", "res://addons/tooltips_pro/plugin.cfg")

[global_group]

persist=""
wild_enemies=""
player=""
detached_env="When game is loaded, DetachedChunks will look thru these objects for intersecting bodies."
elemental_gui=""
detached_env_parent="When game is loaded, DetachedChunks will look thru the children of these objects for intersecting bodies."

[gui]

theme/custom="res://assets/theme/theme.tres"

