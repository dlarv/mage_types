vec2 sdf2d_rotate(vec2 uv, float a) {
	vec2 rv;
	float c = cos(a);
	float s = sin(a);
	uv -= vec2(0.5);
	rv.x = uv.x*c+uv.y*s;
	rv.y = -uv.x*s+uv.y*c;
	return rv+vec2(0.5);
}
