[sub_resource type="VisualShader" id="VisualShader_lthv2"]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;


// Varyings
varying vec4 var_cracks;
varying vec4 var_fingers;

uniform vec4 BaseColor : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
uniform float Roughness : hint_range(0.0, 1.0) = 1.0;
uniform float FingertprintOffset : hint_range(0.0, 1.0) = 0.0;
uniform vec2 UVScale = vec2(1.000000, 1.000000);
uniform float FingertprintScale : hint_range(0.0, 1.0) = 1.0;
uniform sampler2D tex_frg_46 : hint_normal;
uniform float CrackOffset : hint_range(0.0, 1.0, 0.10000000149012) = 1.0;
uniform float CrackScale : hint_range(0.0, 1.0) = 0.5;
uniform sampler2D tex_frg_53;
uniform sampler2D tex_frg_72;
uniform float CrackDetail : hint_range(0.0, 1.0) = 1.0;



void vertex() {
	var_cracks = vec4(0.0);
	var_fingers = vec4(0.0);
}

void fragment() {
// ColorParameter:48
	vec4 n_out48p0 = BaseColor;


// FloatParameter:80
	float n_out80p0 = Roughness;


// FloatParameter:78
	float n_out78p0 = FingertprintOffset;


// Vector2Parameter:81
	vec2 n_out81p0 = UVScale;


// Input:35
	vec2 n_out35p0 = UV;


// VectorOp:82
	vec3 n_out82p0 = vec3(n_out81p0, 0.0) * vec3(n_out35p0, 0.0);


// VectorOp:51
	vec3 n_out51p0 = vec3(n_out78p0) + n_out82p0;


// FloatParameter:79
	float n_out79p0 = FingertprintScale;


// VectorOp:36
	vec3 n_out36p0 = n_out51p0 * vec3(n_out79p0);


// Texture2D:46
	vec4 n_out46p0 = texture(tex_frg_46, vec2(n_out36p0.xy));


// FloatParameter:71
	float n_out71p0 = CrackOffset;


// VectorOp:70
	vec3 n_out70p0 = n_out82p0 + vec3(n_out71p0);


// FloatParameter:76
	float n_out76p0 = CrackScale;


// VectorOp:68
	vec3 n_out68p0 = n_out70p0 * vec3(n_out76p0);


// Texture2D:53
	vec4 n_out53p0 = texture(tex_frg_53, vec2(n_out68p0.xy));


// Texture2D:72
	vec4 n_out72p0 = texture(tex_frg_72, vec2(n_out68p0.xy));


// FloatParameter:74
	float n_out74p0 = CrackDetail;


// VectorOp:73
	vec4 n_out73p0 = n_out72p0 * vec4(n_out74p0);


// VectorOp:77
	vec4 n_out77p0 = n_out53p0 + n_out73p0;


	vec3 n_out47p0;
// ColorOp:47
	{
		float base = vec3(n_out46p0.xyz).x;
		float blend = vec3(n_out77p0.xyz).x;
		if (base < 0.5) {
			n_out47p0.x = 2.0 * base * blend;
		} else {
			n_out47p0.x = 1.0 - 2.0 * (1.0 - blend) * (1.0 - base);
		}
	}
	{
		float base = vec3(n_out46p0.xyz).y;
		float blend = vec3(n_out77p0.xyz).y;
		if (base < 0.5) {
			n_out47p0.y = 2.0 * base * blend;
		} else {
			n_out47p0.y = 1.0 - 2.0 * (1.0 - blend) * (1.0 - base);
		}
	}
	{
		float base = vec3(n_out46p0.xyz).z;
		float blend = vec3(n_out77p0.xyz).z;
		if (base < 0.5) {
			n_out47p0.z = 2.0 * base * blend;
		} else {
			n_out47p0.z = 1.0 - 2.0 * (1.0 - blend) * (1.0 - base);
		}
	}


// Output:0
	ALBEDO = vec3(n_out48p0.xyz);
	ROUGHNESS = n_out80p0;
	NORMAL = n_out47p0;


}
"
varyings/cracks = "0,5"
varyings/fingers = "0,5"
