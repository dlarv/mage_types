		float blend = vec3(n_out77p0.xyz).z;
		if (base < 0.5) {
			n_out47p0.z = 2.0 * base * blend;
		} else {
			n_out47p0.z = 1.0 - 2.0 * (1.0 - blend) * (1.0 - base);
		}
	}


// Output:0
	ALBEDO = vec3(n_out48p0.xyz);
	ROUGHNESS = n_out80p0;
	NORMAL = n_out47p0;


}
