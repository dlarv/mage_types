[sub_resource type="Resource" id="Resource_4omxa"]
script = ExtResource("2_4omxa")
target_method = &"_apply_dmg"
source_code = "const KEY := \"prevent_defeat\"

func setup(actor: BattleActor) -> void:
	if not has_meta(KEY):
		var data: Dictionary[BattleActor, bool] = {}
		set_meta(KEY, data)
	get_meta(KEY)[actor] = false
	print(\"HERE\")

func execute(dmg: int, actor: BattleActor, effect:ModEquipmentEffect) -> int:
	var death_averted: Dictionary[BattleActor, bool] = get_meta(KEY)
	if dmg != 0:
		actor.current_hp -= dmg
		actor.damage_applied.emit(actor.current_hp)
	
		if actor.current_hp <= 0 and not actor.aleady_defeated:
			if not death_averted.get(actor, false):
				effect.activated.emit(actor, \"They survived the attack\")
				actor.current_hp = 1
				death_averted[actor] = true
			else:
				actor.aleady_defeated = true
				actor.was_just_defeated.emit()
		actor.damage_applied.emit(actor.current_hp)
	return dmg
"
metadata/_custom_type_script = "uid://cvxp8g3bj6t6y"

[resource]
script = ExtResource("3_tsc7p")
effects = Array[ExtResource("1_gj31e")]([SubResource("Resource_4omxa")])
