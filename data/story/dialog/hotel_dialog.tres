"sprite": -1
},
&"1_140": {
"dialogue": "I don't know how much more cabin fever I can take.",
"offset": Vector2(5200, 2560),
"options": {
0: {
"condition": Array[Dictionary]([]),
"link": &"1_104",
"text": ""
}
},
"size": Vector2(300.00098, 251.00122),
"speaker": 1,
"sprite": -1
},
&"1_141": {
"dialogue": " See how well you two work together?",
"offset": Vector2(2260, -660),
"options": {
0: {
"condition": Array[Dictionary]([]),
"link": &"1_36",
"text": ""
}
},
"size": Vector2(300, 251.00049),
"speaker": 2,
"sprite": -1
},
&"1_142": {
"dialogue": "But before you do, I just gave you a new attack: [el]Purple[/el] Hit. I'd recommend equipping it before your next lesson.",
"offset": Vector2(1860, -1640),
"options": {
0: {
"condition": Array[Dictionary]([]),
