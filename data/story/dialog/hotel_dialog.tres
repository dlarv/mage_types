"operator": 0,
"value1": "met_monster",
"value2": "true"
}]),
"link": &"4_7",
"text": "How'd he get past that monster?"
}
},
"size": Vector2(300.00058, 353.0005),
"speaker": 2,
"sprite": -1
},
&"1_53": {
"dialogue": "He was just rude and entitled.",
"offset": Vector2(1380, 1860),
