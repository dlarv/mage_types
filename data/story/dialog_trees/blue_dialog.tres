},
&"0_6": {
"link": &"7_3",
"offset": Vector2(-2820, 1940),
"start_id": "SWOLE_1"
},
&"0_7": {
"link": &"7_2",
"offset": Vector2(-1880, 2040),
"start_id": "SWOLE_2"
},
&"0_8": {
