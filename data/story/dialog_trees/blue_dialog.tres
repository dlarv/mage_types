"offset": Vector2(-620, 680),
"options": {
0: {
"condition": Array[Dictionary]([]),
"link": &"1_24",
"text": ""
}
},
"size": Vector2(300, 240),
"speaker": 2
},
&"1_24": {
"dialogue": "First, what are they gonna do? Walk over here and complain? You two are the only ones here that can still walk.",
"offset": Vector2(-300, 680),
"options": {
0: {
"condition": Array[Dictionary]([]),
