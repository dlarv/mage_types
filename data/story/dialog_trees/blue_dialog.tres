&"1_10": {
"dialogue": "Haha, to be honest, I don't know. I can't leave this area, see.",
"offset": Vector2(-860, 40),
"options": {
0: {
"condition": Array[Dictionary]([]),
"link": &"1_11",
"text": "Do you not get a break?"
}
},
"size": Vector2(300, 273),
"speaker": 2
},
&"1_11": {
"dialogue": "You misunderstand. I physically cannot move. I'm rooted in place.",
"offset": Vector2(-540, 40),
"options": {
0: {
"condition": Array[Dictionary]([]),
"link": &"1_14",
"text": "Why?"
}
},
"size": Vector2(300, 273),
"speaker": 2
},
&"1_12": {
"dialogue": "Excellent work. You two are surely be ready to rid us of that fiend!",
"offset": Vector2(-400, 2800),
"options": {
0: {
"condition": Array[Dictionary]([]),
"link": "END",
"text": ""
}
},
"size": Vector2(300, 240),
"speaker": "Duke"
},
&"1_13": {
"dialogue": "An admirable try! Come back when thou art ready to try again.",
"offset": Vector2(-780, 2940),
"options": {
0: {
"condition": Array[Dictionary]([]),
"link": "END",
"text": ""
}
},
"size": Vector2(300, 240),
"speaker": "Duke"
},
&"1_14": {
"dialogue": "Its a long story. Remind me to tell you about it later.",
"offset": Vector2(-220, 40),
"options": {
0: {
"condition": Array[Dictionary]([]),
"link": &"4_4",
"text": ""
}
},
"size": Vector2(300, 240),
"speaker": 2
},
&"1_15": {
"dialogue": "But super quick, before I forget, could I ask you for a quick favor?",
"offset": Vector2(780, 40),
"options": {
0: {
"condition": Array[Dictionary]([]),
"link": &"1_16",
"text": "Sure"
}
},
"size": Vector2(300, 273),
"speaker": 2
},
&"1_16": {
"dialogue": "Up to the left, you'll find a few people playing poker, amongst whom will be my friend. Would you mind grabbing them and bringing them back over here.",
"offset": Vector2(1100, 40),
"options": {
0: {
"condition": Array[Dictionary]([]),
"link": &"1_17",
"text": ""
}
},
"size": Vector2(300, 240),
"speaker": 2
},
&"1_17": {
"dialogue": "The other players might object to you pulling them away. If they do just tell them that I offer to cover their tab.",
"offset": Vector2(1420, 40),
"options": {
0: {
"condition": Array[Dictionary]([]),
"link": &"1_18",
"text": ""
}
},
"size": Vector2(300, 240),
"speaker": 2
},
&"1_18": {
