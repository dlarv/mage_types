"text": ""
}
},
"size": Vector2(300, 240),
"speaker": "Partner"
},
"1_5": {
"dialogue": "Interesting... perhaps then he is up by the caves.",
"offset": Vector2(-1280, 100),
"options": {
0: {
"condition": Array[Dictionary]([]),
"link": &"1_6",
"text": ""
}
},
"size": Vector2(300, 240),
"speaker": 0
},
"1_6": {
"dialogue": "I'm sorry, how rude of me. My name is Crimson, who might you be?",
"offset": Vector2(-940, 100),
"options": {
0: {
"condition": Array[Dictionary]([]),
"link": &"1_7",
"text": "*Introduce yourself*"
}
},
"size": Vector2(300, 257),
"speaker": 0
},
"1_7": {
"dialogue": "...",
"offset": Vector2(-600, 100),
"options": {
0: {
"condition": Array[Dictionary]([]),
"link": &"1_9",
"text": ""
}
},
"size": Vector2(300, 240),
"speaker": 0
},
"1_9": {
"dialogue": "I know we just met, but would you kindly do me a favor?",
"offset": Vector2(-256.935, 104.043),
"options": {
0: {
"condition": Array[Dictionary]([]),
"link": &"1_11",
"text": "Sure!"
},
1: {
