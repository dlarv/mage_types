"1_11": {
"dialogue": "Luckily for you, there should be a supply boat coming in a few days. It can take you back to the mainland.",
"offset": Vector2(1260, 560),
"options": {
0: {
"condition": Array[Dictionary]([]),
"link": &"1_12",
"text": "Is that how you get back to Earth?"
}
},
"size": Vector2(300, 257),
"speaker": 0
},
"1_12": {
"dialogue": "Well, no... sorry. We're not really sure how, or even if, that can be done.",
"offset": Vector2(1600, 560),
"options": {
0: {
"condition": Array[Dictionary]([]),
"link": &"1_13",
"text": ""
}
},
"size": Vector2(300, 240),
"speaker": 0
},
"1_13": {
"dialogue": "I know that must be disappointing...",
"offset": Vector2(1940, 560),
"options": {
0: {
"condition": Array[Dictionary]([]),
"link": &"1_14",
"text": "Not really"
},
1: {
"condition": Array[Dictionary]([]),
"link": &"1_18",
"text": "A little..."
}
},
"size": Vector2(300, 290),
"speaker": 0
},
"1_14": {
"dialogue": "Oh, well in that case you might really like it here.",
"offset": Vector2(2280, 560),
"options": {
0: {
"condition": Array[Dictionary]([]),
"link": &"1_15",
"text": "What makes you say that?"
}
},
"size": Vector2(300, 257),
"speaker": 0
},
"1_15": {
"dialogue": "It might be easier to show you. Follow me.",
"offset": Vector2(2660, 780),
"options": {
0: {
"condition": Array[Dictionary]([]),
"link": &"9_2",
"text": ""
}
},
"size": Vector2(300, 240),
"speaker": 0
},
"1_16": {
"dialogue": "I think Aqua left a few of their experiments up ahead.",
"offset": Vector2(-1840, 900),
"options": {
0: {
"condition": Array[Dictionary]([]),
"link": &"9_3",
"text": ""
}
},
"size": Vector2(300, 240),
"speaker": 0
},
"1_17": {
"dialogue": "Ack!",
"offset": Vector2(-1180, 900),
"options": {
0: {
"condition": Array[Dictionary]([]),
"link": &"3_2",
"text": ""
}
},
"size": Vector2(300, 240),
"speaker": 0
},
"1_18": {
"dialogue": "I'm sorry. But this place isn't all bad.",
